{
  "name": "obsidian-copilot-plugin",
  "version": "0.1.0",
  "description": "Obsidian plugin providing Copilot-like auto-completion for markdown notes",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs production=false",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production=true",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "copilot",
    "ai",
    "completion"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.20.0",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "openai": "^4.28.0"
  }
}
